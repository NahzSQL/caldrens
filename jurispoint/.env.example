# Public URL of the live site, used for canonical links, sitemap and social previews.
NEXT_PUBLIC_SITE_URL=https://jurispoint.site

# Contact form delivery through Resend (https://resend.com). Until all three are set,
# the form does not send: it tells visitors their enquiry was NOT sent and offers
# the phone number and email address instead.
RESEND_API_KEY=
# Address that receives enquiries.
ENQUIRY_TO_EMAIL=stevensgregs@jurispoint.site
# Sender address on a domain you have verified in Resend.
ENQUIRY_FROM_EMAIL=JurisPoint Website <website@jurispoint.site>
