# Appointment request delivery (server-side only; never prefix with NEXT_PUBLIC_).
# Leave everything blank to keep the form in demo mode: it validates input but sends nothing.
#
# Before enabling either option, confirm the provider is suitable for healthcare
# data (e.g. will sign a Business Associate Agreement if HIPAA applies).
#
# Option 1: send each request as JSON to a webhook.
APPOINTMENT_WEBHOOK_URL=
# Optional: sent as "Authorization: Bearer <secret>".
APPOINTMENT_WEBHOOK_SECRET=

# Option 2: email each request through Resend (https://resend.com).
RESEND_API_KEY=
# One address, or several separated by commas.
APPOINTMENT_EMAIL_TO=
# Must be an address on a domain verified in Resend, e.g. "Evercrest Website <appointments@example.com>".
APPOINTMENT_EMAIL_FROM=
