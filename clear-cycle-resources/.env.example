# Copy this file to .env.local (local development) or add these values in your
# hosting provider's environment variable settings. Never commit real secrets.

# Public site URL, used for canonical links, Open Graph tags and the sitemap.
NEXT_PUBLIC_SITE_URL=https://clearcycleresources.site

# --- Contact form email delivery (required for the form to send messages) ---
# SMTP settings from the company's email provider for clearcycleresources.site
# (for example Google Workspace, Microsoft 365, Zoho Mail, or a transactional
# email service such as Postmark, SendGrid, Amazon SES or Resend SMTP).
SMTP_HOST=
# 587 (STARTTLS) or 465 (implicit TLS)
SMTP_PORT=587
# "true" for port 465, otherwise "false". Defaults from the port if left empty.
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=

# Address that inquiries are sent from. Must be allowed to send through the SMTP
# account above. Defaults to SMTP_USER.
CONTACT_FROM_EMAIL=
# Address that receives inquiries. Defaults to kevinbrooks@clearcycleresources.site.
CONTACT_TO_EMAIL=

# --- Optional: Cloudflare Turnstile spam protection ---
# Enabled only when both keys are set. Create keys at dash.cloudflare.com > Turnstile.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
